---
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"div"> & {
  lean?: number;
};
const { lean, class: className, ...props } = Astro.props;
const leanSize = `var(--size-${lean ?? '4'})`;
---

<div class="accent" class:list={[className]} {...props}>
  <div class="accent-inner">
    <slot />
  </div>
</div>

<style define:vars={{ leanSize }}>
  .accent {
    --fill: var(--black);
    filter: drop-shadow(white 1px 1px 1px) drop-shadow(black 2px 2px 0px) ;
    margin-block-end: 0.5rem;
    margin-inline: calc((var(--leanSize) + .5rem) * -1);
  }
  .accent-inner {
    position: relative;
    color: white;
    display: block;
    clip-path: polygon(var(--leanSize) 0, 100% 0%, calc(100% - var(--leanSize)) 100%, 0% 100%);
    padding-inline: var(--leanSize);
    background: var(--fill);
    padding-inline: calc(var(--leanSize) + 1rem);
    padding-block: 1rem;
  }

  .accent :global(> *) {
    margin: 0;
    z-index: 1;
    position: relative;
  }
</style>
